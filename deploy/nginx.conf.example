# Cài vào /etc/nginx/sites-available/english-it sau khi đã cấp chứng chỉ.
# Đổi mọi example.com thành domain thật. Bootstrap HTTP và Certbot: README.md.
# Nginx chạy trên host; Compose chỉ công bố app tại 127.0.0.1:3000.
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # Giữ đường dẫn này trên HTTP để Certbot webroot gia hạn được.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:EnglishITSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Speaking gửi audio WAV dạng base64 trong JSON; server giới hạn 42 MiB.
    client_max_body_size 48m;
    client_body_timeout 120s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "microphone=(self), camera=()" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # App đọc IP đầu tiên. Ghi đè header của client để tránh giả IP/quota.
        # Chỉ bật TRUST_PROXY=1 khi app đứng sau Nginx được kiểm soát này.
        # Không thay bằng $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;

        # Nginx chịu trách nhiệm các header này, kể cả khi trả lỗi 413/502.
        # Bỏ bản upstream để mỗi header chỉ xuất hiện một lần.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
    }
}

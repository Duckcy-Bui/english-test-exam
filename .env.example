# Server only. Copy to .env for Docker Compose, or .env.local for Next dev.
# Never put secrets in NEXT_PUBLIC_*.
ACCESS_CODE=change-this-class-code
AI_BASE_URL=https://api.shopaikey.com
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_MODEL_FALLBACK=gemini-3.8-flash
AI_MOCK=1
RATE_LIMIT_PER_DEVICE=10
RATE_LIMIT_PER_IP=100
# Set to 1 only behind a controlled reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Default data/units. Set fixtures for the original development sample.
EXAM_DATA_DIR=data/units
# Public URL encoded into the listening QR on generated PDFs.
PDF_BASE_URL=https://english.webs.id.vn
# Optional PDF directory. Rebuild committed PDFs with npm run pdf after changing data.
PDF_DATA_DIR=data/pdf
# Optional cookie signing key; otherwise derived from ACCESS_CODE.
SESSION_SECRET=
# Next dev default. Compose overrides this to the persistent quota volume.
RATE_LIMIT_DB=.runtime/rate-limits.sqlite
